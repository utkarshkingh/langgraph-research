# Copy to .env. Secrets are blank on purpose: fill them in, never commit them.

# ---- Auth -------------------------------------------------------------------
# dev  : shared bearer token (local only).
# entra: validate an Entra ID JWT (JWKS); service-to-service uses managed identity.
AUTH_MODE=dev
DEV_TOKEN=local-dev-token
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
RESEARCH_AGENT_APP_ID_URI=

# ---- Service wiring ---------------------------------------------------------
RESEARCH_MODE=http                # http | inproc
RESEARCH_AGENT_URL=http://localhost:8081   # where the research agent's A2A endpoint lives

# ---- State (Postgres) ---------------------------------------------------------
CHECKPOINT_BACKEND=postgres       # orchestrator checkpoints: postgres | sqlite
TASK_STORE_BACKEND=postgres       # research agent A2A tasks: postgres | memory
POSTGRES_PASSWORD=                # used by docker compose; choose any local password
POSTGRES_DSN=postgresql://agent:<password>@localhost:5432/agent

# ---- LLM (company LiteLLM gateway) -----------------------------------------------
MODEL_BACKEND=litellm             # litellm | azure_openai | scripted (offline test double)
LITELLM_BASE_URL=                 # https://<approved-company-litellm>/v1
LITELLM_DEFAULT_MODEL=
LITELLM_VIRTUAL_KEY=
# Only for MODEL_BACKEND=azure_openai (managed identity, no key):
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Tools ------------------------------------------------------------------
SEARCH_BACKEND=tavily             # tavily | mock
TAVILY_API_KEY=
MCP_ENABLED=true                  # starts the local stdio MCP server
