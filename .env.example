# ---- Auth -------------------------------------------------------------------
# dev  : gateway accepts a shared bearer token (DEV_TOKEN). Good for local demo.
# entra: gateway validates an Entra ID (Azure AD) JWT against JWKS; service-to-
#        service calls use managed identity. See common/security.py.
AUTH_MODE=dev
DEV_TOKEN=local-dev-token

# Used only when AUTH_MODE=entra (shown for reference; not needed for the demo)
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
RESEARCH_AGENT_APP_ID_URI=

# ---- Service wiring ---------------------------------------------------------
RESEARCH_MODE=inproc              # inproc | http
RESEARCH_AGENT_URL=http://localhost:8081

# ---- Checkpointer -----------------------------------------------------------
CHECKPOINT_BACKEND=sqlite         # sqlite | postgres
SQLITE_PATH=./checkpoints.sqlite
POSTGRES_DSN=                     # postgresql://user:pass@host:5432/db  (prod)

# ---- Model ------------------------------------------------------------------
MODEL_BACKEND=scripted            # scripted | azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# ---- Tools ------------------------------------------------------------------
SEARCH_BACKEND=mock               # mock | tavily
TAVILY_API_KEY=
MCP_ENABLED=false                 # true spawns the local stdio MCP server
