# Copy to .env to change anything. Every value below is the local default.

# --- Authentication: shared_secret (local) | entra (app checks JWT) | easy_auth (Azure checks JWT)
A2A_AUTH_MODE=shared_secret
A2A_SHARED_SECRET=local-dev-secret
A2A_ENTRA_TENANT_ID=
A2A_ENTRA_AUDIENCE=                 # api://<a2a-api-app-id>

# --- Service URLs
ORCHESTRATOR_URL=http://localhost:8000
RESEARCH_AGENT_URL=http://localhost:8001

# --- Persistence: empty = in memory, set = Postgres (checkpoints + A2A tasks)
POSTGRES_DSN=                       # postgresql://user:pass@host:5432/db

# --- LLM: scripted (offline) | azure_openai (managed identity)
LLM_BACKEND=scripted
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Tools
SEARCH_BACKEND=mock                 # mock | tavily
TAVILY_API_KEY=
MCP_ENABLED=false                   # true = call the MCP server over stdio
